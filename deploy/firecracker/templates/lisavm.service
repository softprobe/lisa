[Unit]
Description=Lisa Firecracker MicroVM Control Plane
Documentation=https://github.com/softprobe/lisa
After=network-online.target lisavm-network.service
Wants=network-online.target
Requires=lisavm-network.service

[Service]
Type=simple
EnvironmentFile=/etc/lisavm/lisavm.env
ExecStart=/usr/local/bin/lisavm
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
TasksMax=infinity

[Install]
WantedBy=multi-user.target
