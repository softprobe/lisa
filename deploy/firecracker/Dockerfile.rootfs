FROM node:22-slim AS lisa-frontend
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM ghcr.io/pgmq/pg18-pgmq:v1.10.0 AS pgmq-ext

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    e2fsprogs \
    git \
    iproute2 \
    iputils-ping \
    jq \
    openssh-client \
    postgresql \
    postgresql-client \
    procps \
    python3 \
    python3-pip \
    python3-venv \
    util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/lib/postgresql/*

COPY --from=pgmq-ext /usr/share/postgresql/18/extension/pgmq* /tmp/pgmq-ext/
RUN pg_ext_dir="$(ls -d /usr/share/postgresql/*/extension | head -n1)" && \
    cp /tmp/pgmq-ext/pgmq* "${pg_ext_dir}/" && \
    rm -rf /tmp/pgmq-ext

WORKDIR /app
COPY pyproject.toml ./pyproject.toml
COPY src ./src
COPY skills ./skills
COPY scripts/provision_lisa.py ./provision_lisa.py
COPY --from=lisa-frontend /ui/dist /app/static

RUN python3 -m venv /opt/lisa-venv && \
    /opt/lisa-venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/lisa-venv/bin/pip install --no-cache-dir '.[openhands]'

COPY deploy/firecracker/guest-bootstrap.sh /usr/local/bin/lisavm-guest-bootstrap
COPY deploy/firecracker/init.sh /sbin/init
RUN chmod 0755 /usr/local/bin/lisavm-guest-bootstrap /sbin/init && \
    mkdir -p -m 0700 /etc/lisavm && \
    mkdir -p /var/lib/lisa /var/log
